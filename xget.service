[Unit]
Description=Xget-Go — single-binary acceleration engine (port of xixu-me/Xget)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust paths to your installation layout.
ExecStart=/usr/local/bin/xget-go
WorkingDirectory=/var/lib/xget
# StateDirectory creates /var/lib/xget owned by the dynamic user and keeps
# it writable under ProtectSystem=strict (disk cache lives here).
StateDirectory=xget
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# ---- Configuration (environment variables) ----
Environment=PORT=8080
Environment=CACHE_DIR=/var/lib/xget/cache
Environment=CACHE_MAX_MB=1024
Environment=CACHE_MAX_FILE_MB=512
# No built-in auth (same as the official Xget): keep this port behind a
# reverse proxy with auth or firewalled to trusted networks.
Environment=TIMEOUT_SECONDS=30
Environment=MAX_RETRIES=3
Environment=RETRY_DELAY_MS=1000
Environment=MAX_PATH_LENGTH=2048
Environment=CACHE_TTL=300

Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
